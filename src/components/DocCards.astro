---
import DocCard from '../components/DocCard.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + (path.startsWith('/') ? path : '/' + path);
const cards = [
  {
    title: 'Privacy Policy',
    description: 'What is stored on your device, what leaves it, and how to remove it.',
    href: withBase('/privacy/'),
  },
  {
    title: 'Terms of Use',
    description: 'What you can and can\'t do with Alcove, and the limits of the licence.',
    href: withBase('/terms/'),
  },
  {
    title: 'Support',
    description: 'Where your data lives, common questions, uninstalling, and how to get help.',
    href: withBase('/support/'),
  },
];
---

<ul class="cards" id="docs">
  {cards.map((card) => <li><DocCard title={card.title} description={card.description} href={card.href} /></li>)}
</ul>
